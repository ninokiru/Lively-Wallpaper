<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Core, UI and player share one publish folder, so a single NLog file configures all
       three processes. This file and its twin in the UI project are byte for byte identical,
       so whichever one survives the merge behaves the same. The process name keeps the logs
       apart and the folder matches Constants.CommonPaths.LogDir, which the log collector
       and the "open logs" actions read. autoFlush matters because a native crash kills the
       process before NLog's buffer is written, and the log is the only trace left behind. -->
  <targets>
    <target 
      name="logfile" 
      xsi:type="File"
      maxArchiveFiles="4"
      archiveAboveSize="50000000"
      concurrentWrites="true"
      autoFlush="true"
      fileName="${specialfolder:LocalApplicationData}/Luma Wallpaper/logs/${processname}_${cached:cached=true:inner=${date:format=yyyyMMdd_HHmmss}}.txt" />
    <target name="logconsole" xsi:type="Console" />
    <target name="debugger" xsi:type="Debugger" layout="${logger}::${message}"/>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="logconsole" />
    <logger name="*" minlevel="Debug" writeTo="logfile" />
    <logger name="*" minlevel="Trace" writeTo="debugger" />
  </rules>
</nlog>
