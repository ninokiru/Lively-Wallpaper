<Page
    x:Class="Lively.UI.WinUI.Views.Pages.AppUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lively.UI.WinUI.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:BoolToVisibilityConverter
            x:Key="VisibleWhenFalse"
            FalseValue="Visible"
            TrueValue="Collapsed" />
        <converters:BoolNegationConverter x:Key="NegateBool" />

        <!--  Built here instead of looked up: only the Color resources (SystemAccentColor)
              are guaranteed in WinUI, the *Brush variants of the system fill colours are not,
              and a missing key silently renders an invisible badge.  -->
        <SolidColorBrush x:Key="UpdateAccentBrush" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="UpdateSuccessBrush" Color="#FF0F7B0F" />
        <SolidColorBrush x:Key="UpdateCriticalBrush" Color="#FFC42B1C" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel
                MaxWidth="900"
                Margin="10,25,10,25"
                HorizontalAlignment="Center"
                Spacing="12">

                <!--  Status banner, one action at a time like the system updater  -->
                <Border
                    Padding="26,24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnSpacing="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Glyph: download mark, spinner while working, state badge  -->
                        <Grid
                            Width="80"
                            Height="80"
                            VerticalAlignment="Center">
                            <FontIcon
                                FontSize="46"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE896;"
                                Visibility="{Binding ShowRefreshGlyph, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                            <ProgressRing
                                Width="62"
                                Height="62"
                                Foreground="{StaticResource UpdateAccentBrush}"
                                IsActive="{Binding IsBusy, Mode=OneWay}"
                                Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <animations:Implicit.ShowAnimations>
                                    <animations:OpacityAnimation
                                        From="0"
                                        To="1.0"
                                        Duration="0:0:0.35" />
                                </animations:Implicit.ShowAnimations>
                            </ProgressRing>
                            <!--  Success badge  -->
                            <Border
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource UpdateSuccessBrush}"
                                BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="13"
                                Visibility="{Binding ShowSuccessBadge, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="White"
                                    Glyph="&#xE8C7;" />
                                <animations:Implicit.ShowAnimations>
                                    <animations:OpacityAnimation
                                        From="0"
                                        To="1.0"
                                        Duration="0:0:0.4" />
                                </animations:Implicit.ShowAnimations>
                            </Border>
                            <!--  Failure badge  -->
                            <Border
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource UpdateCriticalBrush}"
                                BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="13"
                                Visibility="{Binding ShowErrorBadge, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="White"
                                    Glyph="&#xEA39;" />
                            </Border>
                        </Grid>

                        <!--  Status text and the single available action  -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                Style="{ThemeResource TitleTextBlockStyle}"
                                Text="{Binding StatusTitle, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{Binding StatusDetail, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{Binding LastCheckedText, Mode=OneWay}" />

                            <StackPanel
                                Margin="0,16,0,0"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    x:Uid="UpdateCheckAction"
                                    MinWidth="160"
                                    Command="{Binding CheckUpdateCommand}"
                                    IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource NegateBool}}"
                                    Visibility="{Binding IsUpdateAvailable, Mode=OneWay, Converter={StaticResource VisibleWhenFalse}}" />
                                <Button
                                    x:Uid="UpdateApplyAction"
                                    MinWidth="160"
                                    Command="{Binding ApplyUpdateCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{Binding IsUpdateAvailable, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                <Button
                                    x:Uid="UpdateCancelAction"
                                    MinWidth="100"
                                    Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsUpdateDownloading, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                            </StackPanel>

                            <ProgressBar
                                Height="3"
                                Margin="0,18,0,0"
                                IsIndeterminate="{Binding IsUpdateChecking, Mode=OneWay}"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding CurrentProgress, Mode=OneWay}"
                                Visibility="{Binding ShowProgress, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{Binding ProgressText, Mode=OneWay}"
                                Visibility="{Binding ShowProgress, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Release notes, rendered from the changelog the core returns  -->
                <controls:SettingsExpander
                    x:Uid="UpdateLogCard"
                    IsExpanded="{Binding IsUpdateAvailable, Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ScrollViewer
                                MaxHeight="340"
                                Padding="0,4"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{Binding UpdateLogText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
