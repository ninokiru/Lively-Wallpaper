<Page
    x:Class="Lively.UI.WinUI.Views.Pages.Settings.SettingsWallpaperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:customconverters="using:Lively.UI.WinUI.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lively.UI.WinUI.Views.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <customconverters:BooleanToVisibilityConverter x:Key="VisibilityConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="scrollViewer">
            <StackPanel Margin="10,25,10,5" Spacing="{StaticResource SettingGroupControlSpacing}">
                <!--  Appearnace and Behaviour  -->
                <StackPanel>
                    <TextBlock
                        x:Uid="AppearanceBehaviour"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />

                    <!--  depreciated  -->
                    <!--<controls:SettingsCard x:Uid="LockscreenPicture" Visibility="Collapsed">
                        <ToggleSwitch IsOn="{Binding IsLockScreenAutoWallpaper, Mode=TwoWay}" />
                    </controls:SettingsCard>-->

                    <controls:SettingsExpander x:Uid="DesktopPicture" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8B9;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsDesktopAutoWallpaper, Mode=TwoWay}" />
                        <controls:SettingsExpander.Items>
                            <!--
                                This setting was originally used as a global scaling option for live wallpapers.
                                Since scaling is now handled per wallpaper, we repurpose it here for Desktop Picture mode.
                            -->
                            <controls:SettingsCard x:Uid="WallpaperFit">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE73F;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{Binding SelectedWallpaperScalingIndex, Mode=TwoWay}">
                                    <ComboBoxItem x:Uid="WallpaperFitNone" />
                                    <ComboBoxItem x:Uid="WallpaperFitFill" />
                                    <ComboBoxItem x:Uid="WallpaperFitUniform" />
                                    <ComboBoxItem x:Uid="WallpaperFitUniformToFill" />
                                </ComboBox>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander x:Uid="WallpaperInput" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEC77;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedIndex="{Binding SelectedWallpaperInputMode, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="TextOff" />
                            <ComboBoxItem x:Uid="TextMouse" />
                            <ComboBoxItem x:Uid="TextKeyboard" />
                        </ComboBox>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard ContentAlignment="Left">
                                <CheckBox x:Uid="MouseInteractOnDesktop" IsChecked="{Binding MouseMoveOnDesktop, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <InfoBar
                        x:Uid="IconsHidden"
                        Margin="0,0,0,0"
                        VerticalAlignment="Top"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational"
                        Visibility="{Binding IsDesktopIconsHidden, Converter={StaticResource VisibilityConverter}, Mode=OneWay}">
                        <animations:Implicit.ShowAnimations>
                            <animations:TranslationAnimation
                                From="0,-15,0"
                                To="0"
                                Duration="0:0:0.4" />
                            <animations:OpacityAnimation
                                From="0"
                                To="1.0"
                                Duration="0:0:0.6" />
                        </animations:Implicit.ShowAnimations>
                        <animations:Implicit.HideAnimations>
                            <animations:OpacityAnimation
                                From="1.0"
                                To="0"
                                Duration="0:0:0.2" />
                            <animations:TranslationAnimation
                                From="0"
                                To="0,-15,0"
                                Duration="0:0:0.2" />
                        </animations:Implicit.HideAnimations>
                    </InfoBar>
                </StackPanel>

                <!--  Plugin  -->
                <StackPanel>
                    <TextBlock
                        x:Uid="WallpaperPluginGroup"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />
                    <controls:SettingsExpander x:Uid="WebBrowser" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="WebBrowserDiskCache">
                                <ToggleSwitch IsOn="{Binding IsBrowserDiskCacheEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="BrowserDebuggingPort">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <NumberBox
                                        MinWidth="{StaticResource SettingActionControlMinWidth}"
                                        PlaceholderText="9223"
                                        Text="{Binding WebDebuggingPort, Mode=TwoWay}"
                                        Visibility="{Binding IsWebDebuggingEnabled, Converter={StaticResource VisibilityConverter}, Mode=OneWay}" />
                                    <ToggleSwitch
                                        OffContent=""
                                        IsOn="{Binding IsWebDebuggingEnabled, Mode=TwoWay}"
                                        OnContent="" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <!--  WebView2 install required  -->
                    <InfoBar
                        x:Uid="WebViewRequired"
                        Margin="0,0,0,0"
                        VerticalAlignment="Top"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Error"
                        Visibility="{Binding IsWebView2Required, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button x:Uid="TitleDownload" Command="{Binding InstallWebView2Command}" />
                        </InfoBar.ActionButton>
                        <ProgressBar
                            Margin="-50,0,0,0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsWebView2Installing, Mode=OneWay}" />
                    </InfoBar>
                </StackPanel>
                <!--  Music  -->
                <StackPanel>
                    <TextBlock
                        x:Uid="WallpaperMusicGroup"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />
                    <controls:SettingsExpander x:Uid="VisualizerAudioDevice" IsExpanded="{Binding IsShowAudioDevices, Mode=TwoWay}">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8d6;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard ContentAlignment="Left">
                                <ListView
                                    MinWidth="500"
                                    MinHeight="100"
                                    MaxHeight="200"
                                    Background="{ThemeResource ControlFillColorDefault}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    ItemsSource="{Binding AudioDevices, Mode=OneWay}"
                                    SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image
                                                    Width="24"
                                                    Height="24"
                                                    Source="{Binding DeviceIcon}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander x:Uid="AppMusicExclusion" IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xF0E3;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard ContentAlignment="Left">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListView
                                        Grid.Row="0"
                                        MinWidth="500"
                                        MinHeight="100"
                                        MaxHeight="200"
                                        Background="{ThemeResource ControlFillColorDefault}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ItemsSource="{Binding AppMusicExclusionRules}"
                                        SelectedItem="{Binding SelectedAppMusicExclusionRuleItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,5,0,5" Text="{Binding AppName}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <Button Command="{Binding AddAppMusicExclusionRuleCommand}">
                                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        </Button>
                                        <Button Command="{Binding RemoveAppMusicExclusionRuleCommand}">
                                            <FontIcon FontSize="12" Glyph="&#xE738;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <InfoBar
                        x:Name="musicWallpaperRestartNotify"
                        x:Uid="WallpaperRestartRequiredNotify"
                        Margin="0,0,0,0"
                        VerticalAlignment="Top"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational"
                        Visibility="{Binding IsMusicSettingsChanged, Converter={StaticResource VisibilityConverter}, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button x:Uid="RestartCommand" Command="{Binding RestartMusicWallpapersCommand}" />
                        </InfoBar.ActionButton>
                        <animations:Implicit.ShowAnimations>
                            <animations:TranslationAnimation
                                From="0,-15,0"
                                To="0"
                                Duration="0:0:0.4" />
                            <animations:OpacityAnimation
                                From="0"
                                To="1.0"
                                Duration="0:0:0.6" />
                        </animations:Implicit.ShowAnimations>
                        <animations:Implicit.HideAnimations>
                            <animations:OpacityAnimation
                                From="1.0"
                                To="0"
                                Duration="0:0:0.2" />
                            <animations:TranslationAnimation
                                From="0"
                                To="0,-15,0"
                                Duration="0:0:0.2" />
                        </animations:Implicit.HideAnimations>
                    </InfoBar>
                </StackPanel>

                <!--  Playlist  -->
                <StackPanel>
                    <TextBlock
                        x:Uid="PlaylistGroup"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold" />
                    <controls:SettingsCard x:Uid="PlaylistEnable">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsPlaylistEnabled, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="PlaylistInterval" IsEnabled="{Binding IsPlaylistEnabled}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE916;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            SelectedIndex="{Binding SelectedPlaylistIntervalIndex, Mode=TwoWay}">
                            <ComboBoxItem>5</ComboBoxItem>
                            <ComboBoxItem>15</ComboBoxItem>
                            <ComboBoxItem>30</ComboBoxItem>
                            <ComboBoxItem>60</ComboBoxItem>
                            <ComboBoxItem>120</ComboBoxItem>
                            <ComboBoxItem>180</ComboBoxItem>
                            <ComboBoxItem>360</ComboBoxItem>
                            <ComboBoxItem>720</ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="PlaylistShuffle" IsEnabled="{Binding IsPlaylistEnabled}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B1;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding IsPlaylistShuffle, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="PlaylistDays" IsEnabled="{Binding IsPlaylistEnabled}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE787;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            SelectedIndex="{Binding SelectedPlaylistDaysIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="PlaylistDaysEvery" />
                            <ComboBoxItem x:Uid="PlaylistDaysWeekdays" />
                            <ComboBoxItem x:Uid="PlaylistDaysWeekends" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="PlaylistStartTime" IsEnabled="{Binding IsPlaylistEnabled}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE916;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            ItemsSource="{Binding PlaylistHours}"
                            SelectedIndex="{Binding SelectedPlaylistStartHourIndex, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="PlaylistEndTime" IsEnabled="{Binding IsPlaylistEnabled}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE916;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            ItemsSource="{Binding PlaylistHours}"
                            SelectedIndex="{Binding SelectedPlaylistEndHourIndex, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsExpander x:Uid="PlaylistItems" IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xF0E3;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard ContentAlignment="Left">
                                <StackPanel Spacing="6">
                                    <ListView
                                        MinWidth="500"
                                        MinHeight="100"
                                        MaxHeight="200"
                                        Background="{ThemeResource ControlFillColorDefault}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ItemsSource="{Binding PlaylistItems}"
                                        SelectedItem="{Binding SelectedPlaylistItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,5,0,5" Text="{Binding Title}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <ComboBox
                                            MinWidth="240"
                                            DisplayMemberPath="Title"
                                            ItemsSource="{Binding PlaylistSources}"
                                            SelectedItem="{Binding SelectedPlaylistSource, Mode=TwoWay}" />
                                        <ComboBox
                                            MinWidth="140"
                                            ItemsSource="{Binding PlaylistScreens}"
                                            SelectedIndex="{Binding SelectedPlaylistScreenIndex, Mode=TwoWay}" />
                                        <Button Command="{Binding AddPlaylistItemCommand}">
                                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                                        </Button>
                                        <Button Command="{Binding RemovePlaylistItemCommand}">
                                            <FontIcon FontSize="12" Glyph="&#xE738;" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
